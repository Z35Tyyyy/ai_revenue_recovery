# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Project artifacts (regenerated via `make`)
data/*.parquet
data/*.csv
data/*.jsonl
# large; the API regenerates it on startup if absent
data/population.json
# SQLite durable store (regenerated at runtime) — gitignore has no inline comments
*.db
*.db-journal
*.sqlite
*.sqlite3
reports/*.png
reports/*.html
!reports/.gitkeep
!data/.gitkeep
!models/.gitkeep
# NOTE: the trained models (models/*.joblib) and holdout results (reports/eval.json)
# ARE committed so the app runs immediately after `make install`, no `make all` needed.
# Regenerate them any time with `make train` / `make eval`.

# Env / secrets
.env
.env.local
*.key

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/

# OS / editor
.DS_Store
.idea/
.vscode/
*.log
frontend/dist-single/
.claude/settings.local.json

# Windows shell artifact (a `> NUL` redirect creates a real file in Git Bash)
NUL
