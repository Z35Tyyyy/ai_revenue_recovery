# Copy to .env and fill in. Everything here is OPTIONAL — the engine runs
# fully in simulation with deterministic fallbacks when these are absent.

# --- Razorpay TEST MODE keys (https://dashboard.razorpay.com > Settings > API Keys) ---
# Used only for the "recover a real test-mode payment" live demo.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret configured in the Razorpay dashboard for signature verification.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- LLM for dunning-message copy (fully optional) ---
# If no key is set, a high-quality multilingual template generator is used, and
# the evaluation ALWAYS uses templates — so an LLM key never changes your metrics.
#
# Pick ONE provider and set its key:
LLM_PROVIDER=groq                 # anthropic | groq | openai
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx      # for LLM_PROVIDER=anthropic (Claude)
GROQ_API_KEY=gsk_xxxxxxxx               # for LLM_PROVIDER=groq  (cheap/free, Llama etc.)
# OPENAI_API_KEY=sk-xxxxxxxx             # for LLM_PROVIDER=openai
#
# Optional model override; leave unset to use the provider's sensible default
# (claude-opus-5 / llama-3.3-70b-versatile / gpt-4o-mini).
# RECOVERY_LLM_MODEL=llama-3.3-70b-versatile

# --- Engine knobs ---
RECOVERY_SEED=7
RECOVERY_DATA_DIR=data
RECOVERY_MODEL_DIR=models
